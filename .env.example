AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_TRANSCRIBE_DEPLOYMENT=gpt-4o-transcribe
AZURE_OPENAI_TTS_DEPLOYMENT=gpt-4o-mini-tts
# Spark's voice: Azure AI Speech (separate resource: Azure portal > Speech service > Keys and Endpoint). Leave empty to use the Azure OpenAI voice.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
POSTGRES_PASSWORD=change-me
SPARK_ADMIN_PASSWORD=change-me
